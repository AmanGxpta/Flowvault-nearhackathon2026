# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Rust contract build artifacts (keep Cargo.lock)
/contracts/**/target/

# Local references, audit artifacts and scratch work (never submission source)
/reference-clones/
/references/
/.references/
/scratch/
/tmp/

# Private captures, local databases, sessions and wallet material
/private/
/captures/live/
/tests/fixtures/private/
*.sqlite
*.sqlite-*
*.db
*.db-*
*.key
*.keystore
*.p12
*.pfx
*.har
/gitleaks*.json

# Project docs (local only, never published)
/docs/
